{
  "model": "claude-opus-5-5",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker images *)",
      "Bash(docker stats --no-stream *)",
      "Bash(docker system df *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ls *)",
      "Bash(sudo -u bruno docker compose ps *)",
      "Bash(sudo -u bruno docker compose logs *)",
      "Bash(sudo -u bruno cat *)",
      "Bash(sudo -u bruno ls *)",
      "Bash(sudo -u bruno head *)",
      "Bash(sudo -u bruno tail *)",
      "Bash(sudo -u bruno grep *)",
      "Bash(sudo -u bruno find *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl list-units *)",
      "Bash(journalctl *)",
      "Bash(nvidia-smi *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(free *)",
      "Bash(uptime *)",
      "Bash(sensors *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(*environ*)",
      "Bash(sudo -u bruno find * -delete *)",
      "Bash(sudo -u bruno find * -exec *)",
      "Bash(journalctl --vacuum*)",
      "Read(/var/lib/titan-agent/.claude/channels/**)",
      "Read(/var/lib/titan-agent/.claude/.credentials.json)"
    ]
  }
}
